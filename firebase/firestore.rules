rules_version = '2';
// v2.25 (the app review's R25). Market List has no sign-in yet, so these rules cannot say WHO may open a list: its
// code, in the share link, is the key. What they can do, and do:
//  - a list is read only by its exact code; nobody can ask for the list of lists (so codes cannot be harvested);
//  - a list has at most four people (one that somehow has more is never locked out — it just cannot grow);
//  - lists are never deleted through the app (Settings › Your data empties one instead);
//  - an account's own record (users/{uid}) is read and written only by that signed-in person (v2.40); since v2.71 it may
//    also hold a copy of that person's settings (prefs: { at, json }, the keys as one string of at most 40,000 characters) — never list data;
//  - who may open a list is kept in access/{code} (v2.44): once that exists, only its people can open the list;
//  - shared shelf prices (shared/{key}, v2.47): read by any signed-in phone; each email account writes only its own entry;
//  - nothing outside lists/, access/, users/ and shared/ can be read or written.
// The app only ever does: get/listen to lists/{code}, and set it whole (create or update); since v2.58 it also
// listens to lists/{code}/items and sets each lists/{code}/items/{id} whole (one record per item, never deleted); since v2.75
// also lists/{code}/regulars/{rid}, prices/{pid} and spend/{sid} (Regulars, prices and spending, one record each, never deleted). Publish from the Firebase
// console (Firestore Database › Rules) and try it in the Rules Playground first — see docs/firestore-rules.md.
service cloud.firestore {
  match /databases/{database}/documents {
    function people(d) { return d.get('members', []).size(); }

    // v2.44 (architecture review A2, members by account): who may open a list is kept beside it, in access/{code}:
    //   { acl: {uid: true|false}, names: {uid: name}, joinKey, openUntil (ms), joinProof: {uid: key} }.
    // A list with no access record yet (made before v2.44, until one of its phones opens it) stays as before: its code is
    // the key. Once the record exists, only its people can open the list. A new person joins with the key from a share
    // link — or, for the first 30 days (openUntil), with the code alone, so the household's own phones move over without
    // a new link. A person removed is set to false; "New link" changes the key, so an old link stops working.
    function accessPath(code) { return /databases/$(database)/documents/access/$(code); }
    function hasAccess(code) { return exists(accessPath(code)); }
    function memberOf(code) {
      return request.auth != null && get(accessPath(code)).data.acl.get(request.auth.uid, false) == true;
    }

    match /lists/{code} {
      // v2.49 (architecture review S2): only the fields the app writes, of the right kind. A phone on an app older than
      // v2.49 may write a stray old field and be refused until it updates — the owner publishes this (docs/firestore-rules.md).
      function listOk(d) {
        return d.keys().hasOnly(['items','buyAgain','baTomb','stores','storeMeta','members','categories','name','baMeta','predictReset','purch','plan','prices','aisle','memb','shopping','templates','spend','looks','aislemap','itemTomb','parts','v','clr'])
          && d.get('items', []) is list && d.get('items', []).size() <= 3000
          && d.get('itemTomb', {}) is map && d.get('itemTomb', {}).size() <= 5000
          && d.get('buyAgain', []) is list && d.get('buyAgain', []).size() <= 3000
          && d.get('members', []) is list
          && d.get('name', '') is string && d.get('name', '').size() <= 200
          && d.get('stores', []) is list && d.get('stores', []).size() <= 200
          && d.get('v', 0) is int
          && d.get('parts', []) is list && d.get('parts', []).size() <= 8
          && d.get('clr', {}) is map && d.get('clr', {}).size() <= 8;   // v2.75: when prices / spending were last cleared (records older are ignored)
      }
      allow get: if !hasAccess(code) || memberOf(code);
      allow list: if false;
      allow create: if code.size() <= 64 && people(request.resource.data) <= 4 && listOk(request.resource.data);
      allow update: if (!hasAccess(code) || memberOf(code))
                    && listOk(request.resource.data)
                    && (people(request.resource.data) <= 4
                        || people(request.resource.data) <= people(resource.data))
                    // v2.58: a split list (v 3) can never be written back as an old one (an app older than v2.49 does not know v)
                    && (resource.data.get('v', 0) < 3 || request.resource.data.get('v', 0) >= 3)
                    // v2.75: nor a v 4 list (Regulars, prices and spending as records) as 3 or lower
                    && (resource.data.get('v', 0) < 4 || request.resource.data.get('v', 0) >= 4);
      allow delete: if false;

      match /items/{id} {
        // v2.58 (S8 step 2): one record per item. Read and written by the list's people (the same check as the list).
        // An item is never deleted: a removal is the record {id, gone: ms}, so it travels to the other phones.
        function itemOk(d) {
          return d.keys().size() <= 40 && d.get('id', '') == id && id.size() <= 64
            && d.get('name', '') is string && d.get('name', '').size() <= 200
            && d.get('gone', 0) is int && d.get('ts', 0) is number;
        }
        allow get, list: if !hasAccess(code) || memberOf(code);
        allow create, update: if (!hasAccess(code) || memberOf(code)) && itemOk(request.resource.data);
        allow delete: if false;
      }

      // v2.75 (S8 step 3): Regulars, prices and spending, one record each. Read and written by the list's people, never deleted.
      match /regulars/{rid} {
        // one Regular plus k (its key); a removal is {k, gone: ms}
        function regOk(d) {
          return d.keys().size() <= 30 && d.get('k', '') is string && d.get('k', '').size() <= 500
            && (!('name' in d) || (d.name is string && d.name.size() <= 200))
            && (!('gone' in d) || d.gone is int);
        }
        allow get, list: if !hasAccess(code) || memberOf(code);
        allow create, update: if (!hasAccess(code) || memberOf(code)) && regOk(request.resource.data);
        allow delete: if false;
      }
      match /prices/{pid} {
        // { k: the price key, recs: its records }
        function priceOk(d) { return d.keys().hasOnly(['k', 'recs']) && d.get('recs', []) is list && d.get('recs', []).size() <= 30; }
        allow get, list: if !hasAccess(code) || memberOf(code);
        allow create, update: if (!hasAccess(code) || memberOf(code)) && priceOk(request.resource.data);
        allow delete: if false;
      }
      match /spend/{sid} {
        // one receipt's entry, as the app keeps it
        function spendOk(d) { return d.keys().size() <= 20; }
        allow get, list: if !hasAccess(code) || memberOf(code);
        allow create, update: if (!hasAccess(code) || memberOf(code)) && spendOk(request.resource.data);
        allow delete: if false;
      }
    }

    match /access/{code} {
      function signedIn() { return request.auth != null; }
      function me() { return request.auth.uid; }
      function isMember() { return signedIn() && resource.data.acl.get(me(), false) == true; }
      function stillOpen() { return resource.data.get('openUntil', 0) > request.time.toMillis(); }
      function keyShown() { return request.resource.data.get('joinProof', {}).get(me(), '') == resource.data.joinKey; }
      // a join only adds this person (acl, names, joinProof under their own uid) and touches nothing else
      function onlyMe() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return changed.hasOnly(['acl', 'names', 'joinProof'])
          && request.resource.data.acl.diff(resource.data.acl).affectedKeys().hasOnly([me()])
          && request.resource.data.acl[me()] == true
          && request.resource.data.get('names', {}).diff(resource.data.get('names', {})).affectedKeys().hasOnly([me()])
          && request.resource.data.get('joinProof', {}).diff(resource.data.get('joinProof', {})).affectedKeys().hasOnly([me()]);
      }
      function sane(d) {
        return d.keys().hasOnly(['acl', 'names', 'joinKey', 'openUntil', 'joinProof'])
          && d.acl.size() <= 12 && d.get('names', {}).size() <= 12 && d.get('joinProof', {}).size() <= 12
          && d.joinKey is string && d.joinKey.size() >= 16 && d.joinKey.size() <= 64;
      }
      allow get: if resource == null || isMember();   // reading a record that does not exist yet tells a phone to make it
      allow list: if false;
      // the first phone to open a list (or to make one) creates the record, with itself as its only person
      // …and it must start OPEN for at least 20 days: whoever creates it, the list's other phones join by themselves in that
      // time, so a stranger holding an old code cannot lock the household out (and would show up in People, to be removed)
      allow create: if signedIn() && code.size() <= 64 && sane(request.resource.data)
                    && request.resource.data.acl.keys().hasOnly([me()]) && request.resource.data.acl[me()] == true
                    && request.resource.data.get('openUntil', 0) >= request.time.toMillis() + 20 * 24 * 3600 * 1000;
      allow update: if sane(request.resource.data)
                    && (isMember() || (signedIn() && onlyMe() && (stillOpen() || keyShown())));
      allow delete: if false;
    }

    // v2.40: an account remembers which lists are its person's (codes and names only), so a new phone gets them back.
    // Only that person can read or write it. v2.71: it also keeps the person's settings (prefs: { at, json }) — the look,
    // language and preferences, no list data — so a new phone gets them back.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.data.keys().hasOnly(['lists', 'gone', 'updated', 'prefs'])
                   && request.resource.data.get('lists', {}).size() <= 200
                   && request.resource.data.get('gone', {}).size() <= 500
                   && request.resource.data.get('prefs', {}) is map
                   && request.resource.data.get('prefs', {}).keys().hasOnly(['at', 'json'])
                   && request.resource.data.get('prefs', {}).get('json', '') is string
                   && request.resource.data.get('prefs', {}).get('json', '').size() <= 40000;
    }

    // v2.47: shared shelf prices (opt-in). One record per chain and item; each email account writes only its own
    // entry — a unit price and the time — and any signed-in phone reads them. Never names, lists, cards or suburbs.
    match /shared/{key} {
      function mine() { return request.resource.data.by[request.auth.uid]; }
      function okEntry() {
        return mine().keys().hasOnly(['p', 'd']) && mine().p is number && mine().p > 0.05 && mine().p < 1000
          && mine().d is int && mine().d > request.time.toMillis() - 3 * 24 * 3600 * 1000 && mine().d < request.time.toMillis() + 600000;
      }
      function emailAccount() { return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if emailAccount() && key.matches('^[a-z0-9_-]{3,120}$')
                    && request.resource.data.keys().hasOnly(['by']) && request.resource.data.by.keys().hasOnly([request.auth.uid]) && okEntry();
      allow update: if emailAccount() && request.resource.data.keys().hasOnly(['by']) && request.resource.data.by.size() <= 500
                    && request.resource.data.by.diff(resource.data.by).affectedKeys().hasOnly([request.auth.uid]) && okEntry();
      allow delete: if false;
    }

    // v2.53 (architecture review S4): the AI functions' daily count, one document per phone per day, written by the server
    // AS THAT PHONE (its own sign-in — no admin key anywhere). A phone may only add exactly one to one of its own counters:
    // never lower one, never delete, never touch another phone's. Numbers only; nothing about the list.
    match /quota/{uid}/days/{day} {
      function mine() { return request.auth != null && request.auth.uid == uid; }
      // v2.54: written without turning the set of changed keys into a list (v2.53 did, and every count was refused in production —
      // suspected cause). The one changed key is named by hasOnly against each counter in turn.
      function was(k) { return resource == null ? 0 : resource.data.get(k, 0); }
      function up(ks, k) { return ks.hasOnly([k]) && request.resource.data[k] is int && request.resource.data[k] == was(k) + 1; }
      function plusOne() {
        let ks = request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys();
        return ks.size() == 1 && (up(ks, 'receipt') || up(ks, 'card') || up(ks, 'aisle') || up(ks, 'parse')
          || up(ks, 'recipe') || up(ks, 'recipeSearch') || up(ks, 'feedback'));
      }
      allow read: if mine();
      allow create, update: if mine() && day.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$')
                            && request.resource.data.keys().hasOnly(['receipt', 'card', 'aisle', 'parse', 'recipe', 'recipeSearch', 'feedback'])
                            && plusOne();
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
